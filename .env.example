# Copy this to .env and fill in your keys

# Required for sentiment analysis agent
ANTHROPIC_API_KEY=sk-ant-

# Optional - leave blank to use mock data
POLYGON_API_KEY=
FINNHUB_API_KEY=

# Optional - required for the daily digest email (see backend/services/email_sender.py).
# Sign up at resend.com and generate an API key. Without a verified sending
# domain, the default sandbox sender can only deliver to your own Resend
# account's verified address(es).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=StockPulse <onboarding@resend.dev>

# Database (default: local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./stockpulse.db
